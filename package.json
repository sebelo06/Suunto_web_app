{
  "name": "suunto-tracker-backend",
  "version": "1.0.0",
  "description": "Application desktop de suivi Suunto (Electron) : backend Express embarqué + frontend statique",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "desktop:demo": "SUUNTO_DEMO=1 electron .",
    "start:demo": "SUUNTO_DEMO=1 node server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "suunto-api-wrapper": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sebastien.suivi-suunto",
    "productName": "Suivi Suunto",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "js/**/*",
      "css/**/*",
      "images/**/*",
      "index.html",
      "server.js",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
