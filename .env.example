# Copie ce fichier en `.env` et remplis les valeurs pour le développement local.
# En production, définis ces variables directement dans l'environnement
# (jamais de fichier .env committé ou déployé).

# Obligatoire en production : une vraie valeur secrète, longue et aléatoire
# (ex: `openssl rand -hex 32`). En dev, une valeur par défaut faible est
# utilisée si absente.
SESSION_SECRET=

# Origine autorisée à appeler l'API en cross-origin avec les cookies.
FRONTEND_ORIGIN=http://localhost:5500

# Le snap-to-road utilise BRouter (routeur OSM public, gratuit et sans clé) :
# aucune configuration n'est nécessaire.

# Port d'écoute du backend.
PORT=3000

# development | production
NODE_ENV=development
